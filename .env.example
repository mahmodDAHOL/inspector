APP_NAME=Inspection Portal
APP_VERSION=1.0.0
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Generate with: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
MASTER_ENCRYPTION_KEY=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
TOTP_ISSUER=Syria-MOI-Inspection

DB_PASSWORD=
REDIS_PASSWORD=

MEDIAGATE_API_URL=https://mediagate.gov.sy/api
MEDIAGATE_API_KEY=

UPLOAD_DIR=/var/inspection/uploads
MAX_FILE_SIZE_MB=50
AUDIT_LOG_RETENTION_YEARS=7

# Comma-separated list of origins allowed to call the API (CORS) and of
# hostnames the API will accept requests for (TrustedHostMiddleware).
ALLOWED_ORIGINS=https://localhost
ALLOWED_HOSTS=localhost
